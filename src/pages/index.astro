---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const questions = (await getCollection("questions")).map((entry) => entry.data);
---

<Layout
  title="首相動静 日めくりクイズ"
  description="一文字ずつめくって、「終日、公邸で過ごす。」だけで終わる日かどうかを当てるクイズ。実在の首相動静データをもとにしたオリジナルの問題で遊べます。"
>
  <div class="app">
    <header>
      <div class="header-links">
        <a
          href="https://github.com/yadorigi-9-go/pm-dousei-ndo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub リポジトリ"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
        <a
          href="https://twitter.com/m1s_t1e_t0e"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M23.643 4.937c-.835.37-1.732.62-2.675.733.962-.576 1.7-1.49 2.048-2.578-.9.534-1.897.922-2.958 1.13-.85-.904-2.06-1.47-3.4-1.47-2.572 0-4.658 2.086-4.658 4.66 0 .364.042.718.12 1.06-3.873-.195-7.304-2.05-9.602-4.868-.4.69-.63 1.49-.63 2.342 0 1.616.823 3.043 2.072 3.878-.764-.025-1.482-.234-2.11-.583-.004.02-.004.04-.004.06 0 2.257 1.605 4.14 3.737 4.568-.392.106-.803.162-1.227.162-.3 0-.593-.028-.877-.082.593 1.85 2.313 3.198 4.352 3.234-1.595 1.25-3.604 1.995-5.786 1.995-.376 0-.747-.022-1.112-.065 2.062 1.323 4.51 2.093 7.14 2.093 8.57 0 13.255-7.098 13.255-13.254 0-.2-.005-.402-.014-.602.91-.658 1.7-1.477 2.323-2.41z"
            ></path>
          </svg>
        </a>
      </div>
      <h1>首相動静 日めくりクイズ</h1>
      <p class="sub">
        一文字ずつめくって、「終日、公邸で過ごす。」だけで終わる日かどうかを当てよう
      </p>
    </header>

    <div class="disclaimer">
      数値・事実（<a href="https://github.com/isamu/sori" target="_blank" rel="noopener noreferrer">GitHub: isamu/sori</a>、および<a href="https://kanteilog.com/" target="_blank" rel="noopener noreferrer">官邸ログ</a>）に基づくAIの要約を記載しています。<br>記事本文からの引用は行っていません。
    </div>

    <div class="daily-notice hidden" id="dailyNotice" role="status">
      本日はまだ通常モードの問題が配信されていません。ランダムな練習問題でプレイします。
    </div>

    <div id="quizView">
      <div class="hud">
        <span>問 <strong id="qIndex">1</strong> / <span id="qTotal">0</span></span>
        <span>SCORE <strong id="scoreVal">0</strong></span>
      </div>

      <div class="card">
        <div class="seal" id="dateSeal">動静速報・要確認</div>
        <div class="tiles" id="tiles" role="group" aria-label="動静の文章タイル"></div>
        <div class="reveal-count" id="revealCount">めくった文字: 0 / 0</div>

        <div class="question-label" id="questionLabel">Q. 終日、公邸で？</div>

        <div class="guess-row" id="guessRow">
          <button class="guess-btn stay" id="btnStay">過ごす</button>
          <button class="guess-btn out" id="btnOut">過ごしてない</button>
        </div>

        <div class="result" id="result" aria-live="polite">
          <div class="result-head" id="resultHead"></div>
          <div class="result-text" id="resultText"></div>
          <div class="result-score" id="resultScore"></div>
          <a class="source-link" id="sourceLink" target="_blank" rel="noopener noreferrer">官邸ログで確認する →</a>
          <button class="next-btn" id="nextBtn">次の問題へ →</button>
        </div>
      </div>
    </div>

    <div id="endView" class="hidden">
      <div class="card end-card">
        <h2>結果発表</h2>
        <div class="end-score" id="endScore">0</div>
        <div class="end-sub" id="endSub">正解数 0 / 0</div>
        <div class="end-actions">
          <button class="next-btn hidden" id="endMoreBtn">もっと解く</button>
          <button class="replay-btn" id="replayBtn">もう一度プレイ</button>
          <button class="share-btn" id="shareBtn">結果をシェア</button>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ questions }}>
    window.__QUESTIONS__ = questions;
  </script>

  <script>
    import type { CollectionEntry } from "astro:content";
    import { calcScore, formatDate, formatShareDate, getYesterdayISO, pickDailyQuestion, shuffle } from "../lib/quiz-utils";

    type Question = CollectionEntry<"questions">["data"];

    declare global {
      interface Window {
        __QUESTIONS__: Question[];
      }
    }

    const QUESTIONS = window.__QUESTIONS__;

    const dailyNoticeEl = document.getElementById("dailyNotice")!;
    const qIndexEl = document.getElementById("qIndex")!;
    const qTotalEl = document.getElementById("qTotal")!;
    const scoreValEl = document.getElementById("scoreVal")!;
    const dateSealEl = document.getElementById("dateSeal")!;
    const tilesEl = document.getElementById("tiles")!;
    const revealCountEl = document.getElementById("revealCount")!;
    const guessRowEl = document.getElementById("guessRow")!;
    const btnStay = document.getElementById("btnStay") as HTMLButtonElement;
    const btnOut = document.getElementById("btnOut") as HTMLButtonElement;
    const resultEl = document.getElementById("result")!;
    const resultHeadEl = document.getElementById("resultHead")!;
    const resultTextEl = document.getElementById("resultText")!;
    const resultScoreEl = document.getElementById("resultScore")!;
    const sourceLinkEl = document.getElementById("sourceLink") as HTMLAnchorElement;
    const nextBtn = document.getElementById("nextBtn")!;
    const quizView = document.getElementById("quizView")!;
    const endView = document.getElementById("endView")!;
    const endScoreEl = document.getElementById("endScore")!;
    const endSubEl = document.getElementById("endSub")!;
    const endMoreBtn = document.getElementById("endMoreBtn")!;
    const replayBtn = document.getElementById("replayBtn")!;
    const shareBtn = document.getElementById("shareBtn")!;

    let deck: Question[] = [];
    let restQuestions: Question[] = [];
    let mode: "daily" | "practice" = "daily";
    let qPos = 0;
    let score = 0;
    let correctCount = 0;
    let totalAnswered = 0;
    let revealed: boolean[] = [];
    let revealCount = 0;
    let locked = false;
    let currentChars: string[] = [];
    let answerRows: string[] = [];
    let tileEls: HTMLElement[] = [];

    function startGame(): void {
      const yesterday = getYesterdayISO();
      const dailyQ = pickDailyQuestion(QUESTIONS, yesterday);
      restQuestions = QUESTIONS.filter((q) => q !== dailyQ);

      if (dailyQ) {
        mode = "daily";
        deck = [dailyQ];
        dailyNoticeEl.classList.add("hidden");
      } else {
        mode = "practice";
        deck = shuffle(QUESTIONS);
        dailyNoticeEl.classList.remove("hidden");
      }

      qPos = 0;
      score = 0;
      correctCount = 0;
      totalAnswered = 0;
      answerRows = [];
      endView.classList.add("hidden");
      quizView.classList.remove("hidden");
      qTotalEl.textContent = String(deck.length);
      scoreValEl.textContent = String(score);
      loadQuestion();
    }

    const PRACTICE_QUESTION_COUNT = 10;

    function startPractice(): void {
      endView.classList.add("hidden");
      quizView.classList.remove("hidden");
      dailyNoticeEl.classList.add("hidden");
      mode = "practice";
      deck = shuffle(restQuestions).slice(0, PRACTICE_QUESTION_COUNT);
      qPos = 0;
      qTotalEl.textContent = String(deck.length);
      loadQuestion();
    }

    function hasMoreToOffer(): boolean {
      return mode === "daily" && qPos === deck.length - 1 && restQuestions.length > 0;
    }

    function loadQuestion(): void {
      locked = false;
      const q = deck[qPos];
      currentChars = Array.from(q.text);
      revealed = new Array(currentChars.length).fill(false);
      revealCount = 0;

      qIndexEl.textContent = String(qPos + 1);
      dateSealEl.textContent = `首相動静 ${formatDate(q.date)}`;
      resultEl.classList.remove("show", "correct", "wrong");
      guessRowEl.style.display = "grid";
      btnStay.disabled = false;
      btnOut.disabled = false;

      renderTiles();
      updateRevealCount();
    }

    function renderTiles(): void {
      tilesEl.innerHTML = "";
      tileEls = currentChars.map((ch, i) => {
        const tile = document.createElement("div");
        tile.className = "tile";
        tile.setAttribute("role", "button");
        tile.setAttribute("aria-label", `${i + 1}文字目をめくる`);
        tile.tabIndex = 0;

        const inner = document.createElement("div");
        inner.className = "tile-inner";
        const front = document.createElement("div");
        front.className = "tile-face tile-front";
        const back = document.createElement("div");
        back.className = "tile-face tile-back";
        back.textContent = ch;
        inner.append(front, back);
        tile.appendChild(inner);

        tile.addEventListener("click", () => onTileClick(i));
        tile.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            onTileClick(i);
          }
        });

        tilesEl.appendChild(tile);
        return tile;
      });
    }

    function flipTile(i: number): void {
      const tile = tileEls[i];
      if (!tile || tile.classList.contains("revealed")) return;
      tile.classList.add("revealed");
      tile.tabIndex = -1;
      tile.setAttribute("aria-disabled", "true");
      tile.setAttribute("aria-label", `${i + 1}文字目: ${currentChars[i]}`);
    }

    function onTileClick(i: number): void {
      if (locked || revealed[i]) return;
      revealed[i] = true;
      revealCount++;
      flipTile(i);
      updateRevealCount();
    }

    function updateRevealCount(): void {
      revealCountEl.textContent = `めくった文字: ${revealCount} / ${currentChars.length}`;
    }

    function revealAllAuto(): void {
      currentChars.forEach((_, i) => {
        if (!revealed[i]) flipTile(i);
      });
    }

    function onGuess(guessStay: boolean): void {
      if (locked) return;
      locked = true;
      const q = deck[qPos];
      const correct = guessStay === q.stay;
      const n = currentChars.length;
      const r = revealCount;

      revealAllAuto();

      let pts = 0;
      if (correct) {
        pts = calcScore(n, r);
        score += pts;
        correctCount++;
      }
      totalAnswered++;
      const tiles = revealed.map((wasRevealed) => (wasRevealed ? "🏠" : "❔")).join("");
      answerRows.push(`${tiles} → ${correct ? "✅" : "❌"}`);
      scoreValEl.textContent = String(score);

      btnStay.disabled = true;
      btnOut.disabled = true;

      resultEl.classList.add("show", correct ? "correct" : "wrong");
      resultHeadEl.textContent = correct ? "〇 正解" : "✕ 不正解";
      const answerLabel = q.stay ? "過ごす" : "過ごしてない";
      resultTextEl.textContent = `正解: 「${answerLabel}」　／　全文: ${q.text}`;
      resultScoreEl.textContent = correct
        ? `めくった文字数 ${r} / ${n} → +${pts} 点`
        : `めくった文字数 ${r} / ${n} → 0 点`;
      sourceLinkEl.href = `https://kanteilog.com/day/${q.date}`;
      nextBtn.textContent = hasMoreToOffer() ? "結果を見る" : "次の問題へ →";
    }

    function onNextClick(): void {
      if (hasMoreToOffer()) {
        showResult(true);
        return;
      }
      qPos++;
      if (qPos >= deck.length) {
        showResult(false);
      } else {
        loadQuestion();
      }
    }

    function showResult(offerMore: boolean): void {
      quizView.classList.add("hidden");
      endView.classList.remove("hidden");
      endScoreEl.textContent = String(score);
      endSubEl.textContent = `正解数 ${correctCount} / ${totalAnswered}`;
      endMoreBtn.classList.toggle("hidden", !offerMore);
      replayBtn.classList.toggle("hidden", offerMore);
    }

    async function onShareClick(): Promise<void> {
      const dateLabel = formatShareDate();
      const text = `${dateLabel}\n\n${answerRows.join("\n")}\n${totalAnswered}問中${correctCount}問正解。スコア${score}点でした！\n\n#首相動静日めくりクイズ\n\n${location.href}`;
      if (navigator.share) {
        try {
          await navigator.share({ text });
        } catch {
          // ユーザーがキャンセルした場合などはそのまま何もしない
        }
        return;
      }
      const intentUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`;
      window.open(intentUrl, "_blank", "noopener,noreferrer");
    }

    btnStay.addEventListener("click", () => onGuess(true));
    btnOut.addEventListener("click", () => onGuess(false));
    nextBtn.addEventListener("click", onNextClick);
    endMoreBtn.addEventListener("click", startPractice);
    replayBtn.addEventListener("click", startGame);
    shareBtn.addEventListener("click", onShareClick);

    startGame();
  </script>
</Layout>
