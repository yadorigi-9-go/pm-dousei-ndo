---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const questions = (await getCollection("questions")).map((entry) => entry.data);
---

<Layout title="動静めくりクイズ">
  <div class="app">
    <header>
      <h1>動静めくりクイズ</h1>
      <p class="sub">
        一文字ずつめくって、「終日、公邸で過ごす。」だけで終わる日かどうかを当てよう
      </p>
    </header>

    <div class="disclaimer">
      ※ 各問の日付は実在の日付です。「終日、公邸で過ごしたか」「場所」「分類ごとの活動時間」といった数値・事実は、歴代首相動静を構造化して公開しているGitHubリポジトリ
      isamu/sori（出典: 官邸ログ／kanteilog.com が時事通信社・日本経済新聞社・朝日新聞社の首相動静を数値化したもの）を参照しています。個々の記事本文やラベルの原文は引用せず、文章はこの数値・事実のみを根拠にすべてオリジナルで書き下ろしています。
    </div>

    <div id="quizView">
      <div class="hud">
        <span>問 <strong id="qIndex">1</strong> / <span id="qTotal">0</span></span>
        <span>SCORE <strong id="scoreVal">0</strong></span>
      </div>

      <div class="card">
        <div class="seal" id="dateSeal">動静速報・要確認</div>
        <div class="tiles" id="tiles"></div>
        <div class="reveal-count" id="revealCount">めくった文字: 0 / 0</div>

        <div class="question-label" id="questionLabel">Q. 終日、公邸で？</div>

        <div class="guess-row" id="guessRow">
          <button class="guess-btn stay" id="btnStay">過ごす</button>
          <button class="guess-btn out" id="btnOut">過ごしてない</button>
        </div>

        <div class="result" id="result">
          <div class="result-head" id="resultHead"></div>
          <div class="result-text" id="resultText"></div>
          <div class="result-score" id="resultScore"></div>
          <button class="next-btn" id="nextBtn">次の問題へ →</button>
        </div>
      </div>
    </div>

    <div id="endView" class="hidden">
      <div class="card end-card">
        <h2>結果発表</h2>
        <div class="end-score" id="endScore">0</div>
        <div class="end-sub" id="endSub">正解数 0 / 0</div>
        <button class="replay-btn" id="replayBtn">もう一度プレイ</button>
      </div>
    </div>
  </div>

  <script define:vars={{ questions }}>
    window.__QUESTIONS__ = questions;
  </script>

  <script>
    import type { CollectionEntry } from "astro:content";

    type Question = CollectionEntry<"questions">["data"];

    declare global {
      interface Window {
        __QUESTIONS__: Question[];
      }
    }

    const QUESTIONS = window.__QUESTIONS__;

    function formatDate(iso: string): string {
      const [y, m, d] = iso.split("-");
      return `${y}年${Number(m)}月${Number(d)}日`;
    }

    function shuffle<T>(arr: T[]): T[] {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function getYesterdayISO(): string {
      const d = new Date();
      d.setDate(d.getDate() - 1);
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const day = String(d.getDate()).padStart(2, "0");
      return `${y}-${m}-${day}`;
    }

    const qIndexEl = document.getElementById("qIndex")!;
    const qTotalEl = document.getElementById("qTotal")!;
    const scoreValEl = document.getElementById("scoreVal")!;
    const dateSealEl = document.getElementById("dateSeal")!;
    const tilesEl = document.getElementById("tiles")!;
    const revealCountEl = document.getElementById("revealCount")!;
    const guessRowEl = document.getElementById("guessRow")!;
    const btnStay = document.getElementById("btnStay") as HTMLButtonElement;
    const btnOut = document.getElementById("btnOut") as HTMLButtonElement;
    const resultEl = document.getElementById("result")!;
    const resultHeadEl = document.getElementById("resultHead")!;
    const resultTextEl = document.getElementById("resultText")!;
    const resultScoreEl = document.getElementById("resultScore")!;
    const nextBtn = document.getElementById("nextBtn")!;
    const quizView = document.getElementById("quizView")!;
    const endView = document.getElementById("endView")!;
    const endScoreEl = document.getElementById("endScore")!;
    const endSubEl = document.getElementById("endSub")!;
    const replayBtn = document.getElementById("replayBtn")!;

    let deck: Question[] = [];
    let restQuestions: Question[] = [];
    let mode: "daily" | "practice" = "daily";
    let qPos = 0;
    let score = 0;
    let correctCount = 0;
    let totalAnswered = 0;
    let revealed: boolean[] = [];
    let revealCount = 0;
    let locked = false;
    let currentChars: string[] = [];

    function startGame(): void {
      const yesterday = getYesterdayISO();
      const dailyQ = QUESTIONS.find((q) => q.date === yesterday);
      restQuestions = QUESTIONS.filter((q) => q.date !== yesterday);

      if (dailyQ) {
        mode = "daily";
        deck = [dailyQ];
      } else {
        mode = "practice";
        deck = shuffle(QUESTIONS);
      }

      qPos = 0;
      score = 0;
      correctCount = 0;
      totalAnswered = 0;
      endView.classList.add("hidden");
      quizView.classList.remove("hidden");
      qTotalEl.textContent = String(deck.length);
      scoreValEl.textContent = String(score);
      loadQuestion();
    }

    function startPractice(): void {
      mode = "practice";
      deck = shuffle(restQuestions);
      qPos = 0;
      qTotalEl.textContent = String(deck.length);
      loadQuestion();
    }

    function hasMoreToOffer(): boolean {
      return mode === "daily" && qPos === deck.length - 1 && restQuestions.length > 0;
    }

    function loadQuestion(): void {
      locked = false;
      const q = deck[qPos];
      currentChars = Array.from(q.text);
      revealed = new Array(currentChars.length).fill(false);
      revealCount = 0;

      qIndexEl.textContent = String(qPos + 1);
      dateSealEl.textContent = `首相動静 ${formatDate(q.date)}`;
      resultEl.classList.remove("show", "correct", "wrong");
      guessRowEl.style.display = "grid";
      btnStay.disabled = false;
      btnOut.disabled = false;

      renderTiles();
      updateRevealCount();
    }

    function renderTiles(): void {
      tilesEl.innerHTML = "";
      currentChars.forEach((ch, i) => {
        const tile = document.createElement("div");
        tile.className = "tile" + (revealed[i] ? " revealed" : "");
        tile.textContent = revealed[i] ? ch : "";
        if (!revealed[i] && !locked) {
          tile.addEventListener("click", () => onTileClick(i));
        }
        tilesEl.appendChild(tile);
      });
    }

    function onTileClick(i: number): void {
      if (locked || revealed[i]) return;
      revealed[i] = true;
      revealCount++;
      renderTiles();
      updateRevealCount();
    }

    function updateRevealCount(): void {
      revealCountEl.textContent = `めくった文字: ${revealCount} / ${currentChars.length}`;
    }

    function revealAllAuto(): void {
      tilesEl.innerHTML = "";
      currentChars.forEach((ch) => {
        const tile = document.createElement("div");
        tile.className = "tile revealed";
        tile.textContent = ch;
        tilesEl.appendChild(tile);
      });
    }

    function onGuess(guessStay: boolean): void {
      if (locked) return;
      locked = true;
      const q = deck[qPos];
      const correct = guessStay === q.stay;
      const n = currentChars.length;
      const r = revealCount;

      revealAllAuto();

      let pts = 0;
      if (correct) {
        pts = Math.max(10, Math.round(100 * (1 - r / n)));
        score += pts;
        correctCount++;
      }
      totalAnswered++;
      scoreValEl.textContent = String(score);

      btnStay.disabled = true;
      btnOut.disabled = true;

      resultEl.classList.add("show", correct ? "correct" : "wrong");
      resultHeadEl.textContent = correct ? "〇 正解" : "✕ 不正解";
      const answerLabel = q.stay ? "過ごす" : "過ごしてない";
      resultTextEl.textContent = `正解: 「${answerLabel}」　／　全文: ${q.text}`;
      resultScoreEl.textContent = correct
        ? `めくった文字数 ${r} / ${n} → +${pts} 点`
        : `めくった文字数 ${r} / ${n} → 0 点`;
      nextBtn.textContent = hasMoreToOffer() ? "もっと解く" : "次の問題へ →";
    }

    function onNextClick(): void {
      if (hasMoreToOffer()) {
        startPractice();
        return;
      }
      qPos++;
      if (qPos >= deck.length) {
        showEnd();
      } else {
        loadQuestion();
      }
    }

    function showEnd(): void {
      quizView.classList.add("hidden");
      endView.classList.remove("hidden");
      endScoreEl.textContent = String(score);
      endSubEl.textContent = `正解数 ${correctCount} / ${totalAnswered}`;
    }

    btnStay.addEventListener("click", () => onGuess(true));
    btnOut.addEventListener("click", () => onGuess(false));
    nextBtn.addEventListener("click", onNextClick);
    replayBtn.addEventListener("click", startGame);

    startGame();
  </script>
</Layout>
